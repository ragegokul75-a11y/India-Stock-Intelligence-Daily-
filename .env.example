# Configuration reference only. The application does not load .env files automatically.
INDIA_STOCK_DATA_DIR=./data
INDIA_STOCK_DATABASE_DIR=./database
INDIA_STOCK_STALE_DAYS=5
INDIA_STOCK_OPENAI_ENABLED=false
INDIA_STOCK_OPENAI_MODEL=
# NSE sync runs are blocked until an approved unattended access method is configured.
INDIA_STOCK_NSE_SYNC_ENABLED=false
INDIA_STOCK_NSE_SYNC_DAILY_TIME=18:15
INDIA_STOCK_NSE_SYNC_POLL_MINUTES=30
INDIA_STOCK_NSE_SYNC_WINDOW_MINUTES=240
INDIA_STOCK_NSE_SYNC_TIMEOUT_SECONDS=20
# Do not place API keys in this file. Use a secret manager or the current process environment.
